# =============================================================================
# LocalAI Workspace — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env` or any credential.
# =============================================================================

# --------------------------------------------------------------------- runtime
LAIW_ENV=development
LAIW_LOG_LEVEL=INFO
# Absolute paths are optional; defaults are repo-relative.
# LAIW_DATA_DIR=/home/user/localai-workspace/data
# LAIW_STORAGE_DIR=/home/user/localai-workspace/storage

# -------------------------------------------------------------------- database
# Postgres (docker-compose provides one). Leave blank to use local SQLite.
# DATABASE_URL=postgresql+psycopg://localai:localai@localhost:5432/localai
DATABASE_URL=

# --------------------------------------------------------------------- workers
# inline = in-process thread pool (default, zero infra)
# celery = distributed workers below (requires Redis)
LAIW_WORKER_MODE=inline
LAIW_WORKER_CONCURRENCY=4
REDIS_URL=

# ------------------------------------------------------------------------ auth
# Leave blank to auto-generate and persist a per-installation secret.
LAIW_JWT_SECRET=
LAIW_ALLOW_REGISTRATION=true
LAIW_CORS_ORIGINS=*

# ------------------------------------------------------------------- LLM proxy
# Any OpenAI-compatible endpoint works. The Genspark sandbox exposes one through
# OPENAI_BASE_URL / OPENAI_API_KEY, which are picked up automatically.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional Anthropic (Messages API) provider
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
LAIW_DEFAULT_MODEL=gpt-5.4-mini
LAIW_FAST_MODEL=gpt-5.4-mini
LAIW_LLM_TIMEOUT=180
LAIW_LLM_MAX_TOKENS=4096

# ---------------------------------------------------- local model providers
# Ollama (or any OpenAI-compatible local server: llama.cpp / LM Studio / vLLM).
# Example: OLLAMA_BASE_URL=http://localhost:11434
# Leave blank when no local runtime is present; the provider then reports
# UNAVAILABLE honestly instead of failing.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
# Optional thinking control for Ollama models that expose a chain-of-thought
# (e.g. qwen3). Leave blank to use the default OpenAI-compatible /v1 path, which
# already separates reasoning (delta.reasoning) from the answer.
# Set to "false" (or "true") to route Ollama chat/stream through the native
# /api/chat endpoint -- the only surface that genuinely honours `think`.
# NOTE: on some builds `think=false` makes the model inline its raw reasoning
# into `content` (no  thinking markers), which cannot be separated.
LAIW_OLLAMA_THINK=

# Optional extra OpenAI-compatible providers, named after the provider:
#   LAIW_PROVIDER_GROQ_URL=https://api.groq.com/openai/v1
#   LAIW_PROVIDER_GROQ_KEY=...
#   LAIW_PROVIDER_TOGETHER_URL=...
#   LAIW_PROVIDER_TOGETHER_KEY=...
# Keys are read from the environment only; they are never stored in the DB,
# never returned by the API and never rendered in the frontend.

# --------------------------------------------------- model discovery / health
# A model is marked AVAILABLE only after a real minimal request succeeds.
LAIW_MODEL_PROBE_ENABLED=true
# Cache TTL (seconds) for model health verdicts and provider discovery.
LAIW_MODEL_HEALTH_TTL=120
# Timeout (seconds) for a single capability/health probe request.
LAIW_MODEL_PROBE_TIMEOUT=20

# ---------------------------------------------------- local model activation
# A pure, opt-out layer on top of the Model Catalog + Task Routing. It exists to
# report *which locally-installed models are actually usable* -- no API key, no
# cloud provider, no weight download.
#
#   * discovery only lists what the local runtime (Ollama) already has;
#   * a catalog id that is NOT installed is reported NOT_INSTALLED and keeps its
#     NOT_CONFIGURED status -- nothing is ever pulled or downloaded;
#   * only installed + catalog-known ids are probed with one tiny real request,
#     and become AVAILABLE only when that probe genuinely succeeds;
#   * all other (cloud / not-installed) catalog ids stay NOT_CONFIGURED.
#
# Requires a local runtime: set OLLAMA_BASE_URL above and activation applies.
LAIW_LOCAL_ACTIVATION_ENABLED=true
# Probe EVERY installed local model (honest, slower on hosts with many models).
# Set to false to probe only the preferred model below.
LAIW_LOCAL_ACTIVATION_PROBE_ALL=true
# Preferred model when several installed models qualify (never downloaded).
LAIW_LOCAL_ACTIVATION_PREFERRED_MODEL=qwen3:4b

# ------------------------------------------------------------------- tool flags
LAIW_ENABLE_NETWORK_TOOLS=true
LAIW_ENABLE_CODE_EXECUTION=true
LAIW_MAX_UPLOAD_MB=25
LAIW_RATE_LIMIT=240

# --------------------------------------------------------- optional image gen
# Only set these if you have a real image-generation HTTP endpoint.
# Without them, the /api/images generate action returns UNAVAILABLE honestly.
LAIW_IMAGE_PROVIDER_URL=
LAIW_IMAGE_PROVIDER_KEY=

# ------------------------------------------- deterministic LLM for tests only
# Enables the offline "echo" adapter. NEVER enable in production.
LAIW_ENABLE_ECHO_MODEL=false
